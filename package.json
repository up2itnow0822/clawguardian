{
  "name": "clawpowers-guardian",
  "version": "0.1.0",
  "description": "Open-source security framework for AI agent skill ecosystems. Static analysis, behavioral monitoring, and trust scoring for OpenClaw skills and plugins.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "clawguardian": "dist/cli/index.js",
    "clawpowers-guardian": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/ tests/",
    "prepare": "node scripts/prepare.cjs",
    "scan": "node dist/cli/index.js scan",
    "audit": "node dist/cli/index.js audit"
  },
  "keywords": [
    "openclaw",
    "security",
    "agent",
    "ai",
    "skill-scanning",
    "malware-detection",
    "trust-scoring",
    "clawhub",
    "clawguardian",
    "clawpowers-guardian"
  ],
  "author": "Bill Wilson <bill@ai-agent-economy.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/up2itnow0822/clawguardian.git"
  },
  "homepage": "https://github.com/up2itnow0822/clawguardian",
  "bugs": {
    "url": "https://github.com/up2itnow0822/clawguardian/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "glob": "^10.3.0",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^10.1.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testTimeout": 120000,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  }
}
